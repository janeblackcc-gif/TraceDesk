# Optional: copy to .env in the project root. Process environment takes precedence.
# Relative data paths are resolved from the project root, not the shell directory.
TRACEDESK_DATA_DIR=./data
TRACEDESK_PORT=8765
TRACEDESK_OLLAMA_URL=http://127.0.0.1:11434
TRACEDESK_EMBED_MODEL=qwen3-embedding:0.6b-q8_0
TRACEDESK_CHAT_MODEL=qwen3.5:4b-q4_K_M
# Ollama 0.33.3 is the tested runtime. Only local HTTP model endpoints are accepted.
# Embedding context: 8192; generation: num_ctx=16384, num_predict=3072, temperature=0, seed=42, think=false.
