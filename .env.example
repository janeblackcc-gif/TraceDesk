# Optional: copy to .env in the project root. Process environment takes precedence.
# Relative data paths are resolved from the project root, not the shell directory.
TRACEDESK_DATA_DIR=./data
TRACEDESK_PORT=8765
# The formal deployment uses two local vLLM OpenAI-compatible servers.
TRACEDESK_MODEL_PROVIDER=vllm
TRACEDESK_VLLM_CHAT_URL=http://127.0.0.1:8000
TRACEDESK_VLLM_EMBED_URL=http://127.0.0.1:8001
TRACEDESK_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
TRACEDESK_CHAT_MODEL=Qwen/Qwen3-4B-Instruct-2507
# Replace with SHA-256 identities of the pinned model revisions before startup.
TRACEDESK_EMBED_MODEL_DIGEST=REPLACE_WITH_64_HEX_DIGEST
TRACEDESK_CHAT_MODEL_DIGEST=REPLACE_WITH_64_HEX_DIGEST
# Development compatibility only: set TRACEDESK_MODEL_PROVIDER=ollama and the
# legacy Ollama URL/model tags when reproducing historical local evidence.
TRACEDESK_OLLAMA_URL=http://127.0.0.1:11434
# Team migration mode requires PostgreSQL and an up-to-date Alembic schema.
# Set DATABASE_URL through the process environment or a private .env file.
# Scheme: postgresql+psycopg. Never commit credentials.
